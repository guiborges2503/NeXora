    {
      "name": "API-01 a API-03 - Autenticação (RF-01, RNF-02)",
      "item": [
        {
          "name": "API-01 - Login válido retorna 200 e token (CT-001)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth_login.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth_login.php"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{gestorEmail}}\",\n  \"password\": \"{{senhaTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API-01: status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Contrato: corpo JSON com 'success' booleano\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"success\").that.is.a(\"boolean\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"API-01: success = true e mensagem 'Login realizado'\", function () {",
                  "    pm.expect(body.success).to.eql(true);",
                  "    pm.expect(body.message).to.eql(\"Login realizado\");",
                  "});",
                  "pm.test(\"API-01: dados do usuário corretos\", function () {",
                  "    pm.expect(body.data.email).to.eql(pm.environment.get(\"gestorEmail\"));",
                  "    pm.expect(body.data.status).to.eql(\"active\");",
                  "});",
                  "pm.test(\"API-01: resposta não expõe hash de senha\", () => pm.expect(body.data).to.not.have.property(\"password_hash\"));",
                  "pm.test(\"API-01: token salvo em variável do ambiente\", function () {",
                  "    pm.expect(body.data.token).to.be.a(\"string\").and.not.empty;",
                  "    pm.environment.set(\"tokenGestor\", body.data.token);",
                  "});",
                  "pm.test(\"API-01: tempo de resposta < 2000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(2000));"
                ]
              }
            }
          ]
        },
