        {
          "name": "API-03 - Listagem de dashboards sem token retorna 401 (CT-005a)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboards.php",
