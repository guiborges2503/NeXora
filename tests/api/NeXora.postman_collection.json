              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API-03: status 401\", () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test(\"API-03: nenhum dado retornado\", () => pm.expect(body.data === undefined || body.data === null || (Array.isArray(body.data) && body.data.length === 0)).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "API-03b - Token alterado retorna 401 (CT-005b)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlterado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboards.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboards.php"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Altera o último caractere da assinatura do token válido do gestor",
                  "const t = pm.environment.get(\"tokenGestor\") || \"a.b.c\";",
                  "const ultimo = t.slice(-1) === \"A\" ? \"B\" : \"A\";",
                  "pm.environment.set(\"tokenAlterado\", t.slice(0, -1) + ultimo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API-03b: status 401\", () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test(\"API-03b: nenhum dado retornado\", () => pm.expect(body.data === undefined || body.data === null || (Array.isArray(body.data) && body.data.length === 0)).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
