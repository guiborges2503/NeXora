{
    "name": "nexora/nexora",
    "description": "NeXora - plataforma web de BI com suporte a IA (TCC). Dependencias de teste do Projeto P2 / TQS.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "api/app/",
            "Shared\\": "api/shared/"
        },
        "files": [
            "api/database/db_dialect.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit"
    },
    "config": {
        "sort-packages": true
    }
}
