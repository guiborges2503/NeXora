# Opcional — secrets e integrações (NÃO inclui banco de dados)
# O MySQL é configurado em api/settings/settings.php
#
# Copie para api/.env apenas se quiser sobrescrever JWT, OpenRouter ou e-mail.

JWT_SECRET=defina-um-segredo-forte-e-unico
JWT_TTL_SECONDS=86400

FRONTEND_PUBLIC_URL=https://nexora.conectaxcon.com.br

# Desenvolvimento no PC — MySQL remoto da Hostinger (obrigatório para npm run dev)
# Painel Hostinger → Bancos de dados → MySQL remoto → habilite seu IP e copie o host
# DB_REMOTE_HOST=auth-db746.hstgr.io

# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
