# =============================================================================
# Ambiente LOCAL de testes (Projeto P2 / TQS)
#
# Copie este arquivo para api/.env:
#   cp api/.env.testing.example api/.env
#
# Todos os valores são FICTÍCIOS e servem apenas para o MySQL local / CI.
# api/.env está no .gitignore e nunca deve ser versionado.
# =============================================================================

# Banco local criado por scripts/reset-test-db.sh
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexora_test
DB_USER=nexora_test
DB_PASS=nexora_test_local
DB_TARGET=test

# JWT de teste (não usar em produção)
JWT_SECRET=nexora-test-secret-p2-tqs
JWT_TTL_SECONDS=86400

FRONTEND_PUBLIC_URL=http://127.0.0.1:5173

# IA: deixe vazio. Nos testes automatizados o OpenRouter é simulado.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
